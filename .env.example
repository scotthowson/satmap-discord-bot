# The bot's token: Discord developer portal, your application, Bot, Reset Token. Keep it to yourself.
SATMAP_BOT_TOKEN=
# Your Discord server's ID (Developer Mode on, right-click the server, Copy Server ID). Commands appear there at once.
SATMAP_GUILD_ID=
# Where SatMap answers, as seen from the container. Same machine as the game server: http://host.docker.internal:8765
SATMAP_URL=http://host.docker.internal:8765
# The map's public address: adds an "Open the map" button to every answer. Optional.
SATMAP_MAP_URL=
# Channels where answers are public (comma-separated IDs); asked elsewhere, only the asker sees the answer. Empty: public everywhere.
SATMAP_CHANNEL_IDS=
# Roles that may use the commands (comma-separated IDs). Empty: everyone.
SATMAP_ROLE_IDS=
# A channel for the live board: one message kept up to date. Empty: off.
SATMAP_BOARD_CHANNEL_ID=
# Channels for news (joined, left, server up or down) and for alerts. Empty: off. SatMap's own webhook can post these too: use one or the other.
SATMAP_NEWS_CHANNEL_ID=
SATMAP_ALERTS_CHANNEL_ID=
# 1 everything, 2 warnings and faults, 3 faults only
SATMAP_ALERTS_MIN_SEVERITY=2
# Who to ping on a fault, e.g. <@&ROLE_ID>. Optional.
SATMAP_ALERTS_MENTION=
# true: every answer is shown to the asker alone
SATMAP_PRIVATE_REPLIES=false
TZ=UTC
